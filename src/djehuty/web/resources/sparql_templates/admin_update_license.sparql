{% extends "prefixes.sparql" %}
{% block query %}
DELETE {
  GRAPH <{{state_graph}}> {
    ?dataset djht:license ?current_license .
  }
}
{#- A NEW_LICENSE_URL of None clears the licence rather than setting one.
 #- The revert path needs that when a DOI update fails on a dataset that
 #- had no licence to begin with. #}
{%- if new_license_url is not none %}
INSERT {
  GRAPH <{{state_graph}}> {
    ?dataset djht:license <{{new_license_url}}> .
  }
}
{%- endif %}
WHERE {
  GRAPH <{{state_graph}}> {
    ?container rdf:type                      djht:DatasetContainer ;
               djht:latest_published_version ?dataset .
    OPTIONAL { ?dataset djht:license ?current_license . }
    FILTER (?container = <{{container_uri}}>)
    FILTER (?dataset   = <{{dataset_uri}}>)
  }
}
{% endblock %}
